{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tps:document:0.1.0-draft",
  "title": "TPS document envelope draft, not full element semantics",
  "type": "object",
  "properties": {
    "format": {
      "const": "tps.document"
    },
    "schemaVersion": {
      "const": "0.1.0-draft"
    },
    "units": {
      "const": "um"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "requiredFeatures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 1
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "units",
    "title",
    "locale",
    "timeZone",
    "requiredFeatures",
    "sections",
    "datasets",
    "assets",
    "provenance",
    "extensions"
  ],
  "additionalProperties": false,
  "$defs": {
    "feature": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rotationMilliDegrees": {
          "type": "integer",
          "minimum": -360000,
          "maximum": 360000
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "decimal",
            "boolean",
            "date",
            "dateTime",
            "binary"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "type"
      ],
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "queryRef": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "classId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "classId",
            "version"
          ],
          "additionalProperties": false
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "required": [
        "id",
        "queryRef",
        "ordinal",
        "fields"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "property": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "field"
                },
                "datasetId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                },
                "fieldId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
                }
              },
              "required": [
                "kind",
                "datasetId",
                "fieldId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "expression"
                },
                "language": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "ast": {
                  "type": "object"
                }
              },
              "required": [
                "kind",
                "language",
                "version",
                "ast"
              ],
              "additionalProperties": false
            }
          ]
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "row",
                "group",
                "report",
                "page"
              ]
            },
            "event": {
              "enum": [
                "beforePrint",
                "printOnPage"
              ]
            }
          },
          "required": [
            "scope",
            "event"
          ],
          "additionalProperties": false
        },
        "nullPolicy": {
          "enum": [
            "empty",
            "literal",
            "error"
          ]
        }
      },
      "required": [
        "property",
        "source",
        "evaluation",
        "nullPolicy"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objectRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "sha256",
        "mediaType",
        "byteLength",
        "objectRef"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "margins": {
          "type": "object",
          "properties": {
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "right": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "width",
        "height",
        "margins"
      ],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "typeVersion": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "properties": {
          "type": "object"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "required": [
        "id",
        "type",
        "typeVersion",
        "frame",
        "properties",
        "bindings",
        "children"
      ],
      "additionalProperties": false
    },
    "band": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "datasetId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "properties": {
          "type": "object"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "childBands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/band"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "height",
        "properties",
        "elements",
        "childBands"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "bands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/band"
          }
        }
      },
      "required": [
        "id",
        "page",
        "bands"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "native",
            "rps-xml",
            "excel"
          ]
        },
        "importRecordRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "elementOrigins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "elementId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "elementId",
              "locator"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "origin",
        "elementOrigins"
      ],
      "additionalProperties": false
    }
  }
}
